void control_A(
    chan<boolean>.read b_ready,
    chan<boolean>.read c_ready,
    chan<boolean>.read d_ready,
    chan<int>.read b_priority_update,
    chan<int>.read c_priority_update,
    chan<int>.read d_priority_update,
    chan<int>.write b_start,
    chan<int>.write c_start,
    chan<int>.write d_start)
{
    int bPriority = 0;
    int cPriority = 0;
    int dPriority = 0;

    int totalJobs = 0;
    int bCount = 0;
    int cCount = 0;
    int dCount = 0;

    int selected = -1;
    boolean any;

    while (totalJobs < JOB_LIMIT) {
        /*
         * Phase 1: tell every laser to calculate a fresh priority.
         */
        par {
            b_start.write(REFRESH);
            c_start.write(REFRESH);
            d_start.write(REFRESH);
        }

        /*
         * Wait until all three priority values have arrived.
         */
        bPriority = b_priority_update.read();
        cPriority = c_priority_update.read();
        dPriority = d_priority_update.read();

        println(
            "Priorities before ALT: B=" + bPriority +
            ", C=" + cPriority +
            ", D=" + dPriority);

        selected = -1;

        /*
         * Every laser has answered REFRESH, so all three are available.
         * The largest numeric priority is selected.
         */
        pri alt {
            pri(bPriority) skip: {
                selected = 0;
                bCount++;
            }

            pri(cPriority) skip: {
                selected = 1;
                cCount++;
            }

            pri(dPriority) skip: {
                selected = 2;
                dCount++;
            }
        }

        totalJobs++;

        /*
         * Phase 2: start only the selected laser and wait for completion.
         */
        if (selected == 0) {
            println("Laser B with priority " + bPriority);
            b_start.write(WORK);
            any = b_ready.read();
        } else if (selected == 1) {
            println("Laser C with priority " + cPriority);
            c_start.write(WORK);
            any = c_ready.read();
        } else {
            println("Laser D with priority " + dPriority);
            d_start.write(WORK);
            any = d_ready.read();
        }
    }

    println(
        "Dispatch totals: B=" + bCount +
        ", C=" + cCount +
        ", D=" + dCount);

    /*
     * All lasers are waiting for another command here.
     */
    par {
        b_start.write(STOP);
        c_start.write(STOP);
        d_start.write(STOP);
    }

    println("Control_A finished.");
}

void laser_B(
    chan<boolean>.write b_ready,
    chan<int>.read b_start,
    chan<int>.write b_priority_update)
{
    int signal;
    int newPriority;
    int count = 1;

    while (true) {
        signal = b_start.read();

        if (signal == STOP) {
            println("Laser_B terminates.");
            break;
        }

        if (signal == REFRESH) {
            newPriority = calculatePriority(0);
            setPriority(newPriority, b_priority_update);
        } else if (signal == WORK) {
            println("Laser_B starts to work....time " + count);
            count++;

            jl_sleep(2000);

            /* Tell the controller that this work has completed. */
            b_ready.write(true);
        }
    }
}

void laser_C(
    chan<boolean>.write c_ready,
    chan<int>.read c_start,
    chan<int>.write c_priority_update)
{
    int signal;
    int newPriority;
    int count = 1;

    while (true) {
        signal = c_start.read();

        if (signal == STOP) {
            println("Laser_C terminates.");
            break;
        }

        if (signal == REFRESH) {
            newPriority = calculatePriority(1);
            setPriority(newPriority, c_priority_update);
        } else if (signal == WORK) {
            println("Laser_C starts to work....time " + count);
            count++;

            jl_sleep(200);

            c_ready.write(true);
        }
    }
}

void laser_D(
    chan<boolean>.write d_ready,
    chan<int>.read d_start,
    chan<int>.write d_priority_update)
{
    int signal;
    int newPriority;
    int count = 1;

    while (true) {
        signal = d_start.read();

        if (signal == STOP) {
            println("Laser_D terminates.");
            break;
        }

        if (signal == REFRESH) {
            newPriority = calculatePriority(2);
            setPriority(newPriority, d_priority_update);
        } else if (signal == WORK) {
            println("Laser_D starts to work....time " + count);
            count++;

            jl_sleep(300);

            d_ready.write(true);
        }
    }
}


