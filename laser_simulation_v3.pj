import std.*;

const int JOB_LIMIT = 20;
const int STOP = 0;
const int WORK = 1;
const int REFRESH = 2;

/* Calculate priorities from the current time. */
int calculatePriority(int laserId) {

    if (laserId == 0) return 10;
    if (laserId == 1) return 20;
    return 30;
}

/* Send a laser's new priority to control_A. */
void setPriority(int value, chan<int>.write priority_update) {
    priority_update.write(value);
}

