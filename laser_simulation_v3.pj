public void main(string[] args) {
    chan<int> b_start, c_start, d_start;
    chan<boolean> b_ready, c_ready, d_ready;
    chan<int> b_priority_update, c_priority_update, d_priority_update;

    par {
        control_A(
            b_ready.read,
            c_ready.read,
            d_ready.read,
            b_priority_update.read,
            c_priority_update.read,
            d_priority_update.read,
            b_start.write,
            c_start.write,
            d_start.write);

        laser_B(b_ready.write, b_start.read, b_priority_update.write);
        laser_C(c_ready.write, c_start.read, c_priority_update.write);
        laser_D(d_ready.write, d_start.read, d_priority_update.write);
    }
}
