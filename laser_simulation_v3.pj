import std.*;

const int JOB_LIMIT = 20;

/* Calculate priorities from the current time. */
int calculatePriority(int laserId) {

    if (laserId == 0) return 20;
    if (laserId == 1) return 10;
    return 30;
}

/* Send a laser's new priority to control_A. */
void setPriority(int value, chan<int>.write priority_update) {
    priority_update.write(value);
}

void control_A(
    chan<boolean>.read  b_ready,
    chan<boolean>.read  c_ready,
    chan<boolean>.read  d_ready,
    chan<int>.read b_priority_update,
    chan<int>.read c_priority_update,
    chan<int>.read d_priority_update,
    chan<int>.write b_start,
    chan<int>.write c_start,
    chan<int>.write d_start)
{
    int bPriority = 30;
    int cPriority = 20;
    int dPriority = 10;

    int newPriority;
    int startSignal;
    int totalJobs = 0;
    int bCount = 0;
    int cCount = 0;
    int dCount = 0;
    boolean any;

    while (totalJobs < JOB_LIMIT) {
        pri alt {
            pri(bPriority) any = b_ready.read(): {
                totalJobs++;
                bCount++;
                
                /* Signal 2 means this is the final job: do not publish a next priority. */
                if (totalJobs == JOB_LIMIT)
                    startSignal = 2;
                else
                    startSignal = 1;

                println("Laser B with priority " + bPriority);
                b_start.write(startSignal);

                /* Complete the priority-update handshake before another dispatch. */
                if (startSignal == 1) {
                    newPriority = b_priority_update.read();
                    bPriority = newPriority;
                    println("B sets its next priority to " + bPriority);
                }
            }

            pri(cPriority) any = c_ready.read(): {
                totalJobs++;
                cCount++;

                if (totalJobs == JOB_LIMIT)
                    startSignal = 2;
                else
                    startSignal = 1;

                println("Laser C with priority " + cPriority);
                c_start.write(startSignal);

                if (startSignal == 1) {
                    newPriority = c_priority_update.read();
                    cPriority = newPriority;
                    println("C sets its next priority to " + cPriority);
                }
            }

            pri(dPriority) any = d_ready.read(): {
                totalJobs++;
                dCount++;

                if (totalJobs == JOB_LIMIT)
                    startSignal = 2;
                else
                    startSignal = 1;

                println("Laser D with priority " + dPriority);
                d_start.write(startSignal);

                if (startSignal == 1) {
                    newPriority = d_priority_update.read();
                    dPriority = newPriority;
                    println("D sets its next priority to " + dPriority);
                }
            }
        }
    }

    println("Dispatch totals: B=" + bCount + ", C=" + cCount + ", D=" + dCount);

    par {
        b_ready.read();
        c_ready.read();
        d_ready.read();
        b_start.write(0);
        c_start.write(0);
        d_start.write(0);
    }

    println("Control_A finished.");
}

void laser_B(
    chan<boolean>.write b_ready,
    chan<int>.read b_start,
    chan<int>.write b_priority_update)
{
    int signal;
    int newPriority;
    b_ready.write(true);
    int count = 1;

    while (true) {
        signal = b_start.read();

        if (signal == 0) {
            println("Laser_B terminates.");
            break;
        }

        if (signal == 1) {
            newPriority = calculatePriority(0);
            setPriority(newPriority, b_priority_update);
        }

        println("Laser_B starts to work....time " + count);
        count++;
        jl_sleep(2000);
        b_ready.write(true);
    }
}

void laser_C(
    chan<boolean>.write c_ready,
    chan<int>.read c_start,
    chan<int>.write c_priority_update)
{
    int signal;
    int newPriority;
    c_ready.write(true);
    int count = 1;

    while (true) {
        signal = c_start.read();

        if (signal == 0) {
            println("Laser_C terminates.");
            break;
        }

        if (signal == 1) {
            newPriority = calculatePriority(1);
            setPriority(newPriority, c_priority_update);
        }

        println("Laser_C starts to work....");
        count++;
        jl_sleep(200);
        c_ready.write(true);
    }
}

void laser_D(
    chan<boolean>.write d_ready,
    chan<int>.read d_start,
    chan<int>.write d_priority_update)
{
    int signal;
    int newPriority;
    d_ready.write(true);
    int count = 1;

    while (true) {
        signal = d_start.read();

        if (signal == 0) {
            println("Laser_D terminates.");
            break;
        }

        if (signal == 1) {
            newPriority = calculatePriority(1);
            setPriority(newPriority, d_priority_update);
        }

        println("Laser_D starts to work....");
        count++;
        jl_sleep(300);
        d_ready.write(true);
    }
}

public void main(string[] args) {
    chan<int> b_start, c_start, d_start;
    chan<boolean> b_ready, c_ready, d_ready;
    chan<int> b_priority_update, c_priority_update, d_priority_update;

    par {
        control_A(
            b_ready.read,
            c_ready.read,
            d_ready.read,
            b_priority_update.read,
            c_priority_update.read,
            d_priority_update.read,
            b_start.write,
            c_start.write,
            d_start.write);

        laser_B(b_ready.write, b_start.read, b_priority_update.write);
        laser_C(c_ready.write, c_start.read, c_priority_update.write);
        laser_D(d_ready.write, d_start.read, d_priority_update.write);
    }
}
